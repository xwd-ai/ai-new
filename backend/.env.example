# DeepSeek API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 混合检索需要独立的 OpenAI 兼容 E5 Embedding 服务
# RETRIEVAL_MODE=hybrid
# EMBEDDING_BASE_URL=https://127.0.0.1:18443/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# 使用私有服务证书与 Docker Unix Socket 中继时配置以下两项
# EMBEDDING_CA_FILE=/run/ainew-embedding/server.crt
# EMBEDDING_SOCKET=/run/ainew-embedding/embedding.sock

# 数据库连接：不填则使用本地 SQLite（backend/app.db），零外部依赖。
# 切换 MySQL 时取消注释（端口与 docker-compose.yml 保持一致）：
# DATABASE_URL=mysql+pymysql://ainew:ainew@127.0.0.1:3307/ainew?charset=utf8mb4
#
# 连接池参数（仅服务端数据库生效，SQLite 忽略）：
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800

# 缓存（可选）：不填则不启用缓存，业务照常运行（令牌仍查库、限流降级放行）
# REDIS_URL=redis://127.0.0.1:6379/0
#
# 对话接口每分钟限流阈值，仅在缓存可用时生效
# RATE_LIMIT_CHAT_PER_MINUTE=10

# Go 检索服务地址（可选）：不填则检索与入库分块全部走本地 Python 实现。
# 配置后优先调用 Go，连接失败或超时会自动降级回本地，不影响业务。
# GO_RETRIEVAL_URL=http://127.0.0.1:8081

# Go 业务服务地址（可选）：不填则订单查询、待确认工单列表与工单状态流转
# 全部走本地 Python 实现。
# 配置后优先调用 Go（订单查询、待确认列表、confirm / cancel / update_status 流转），
# 失败或响应无法识别时自动降级到本地，业务行为不受影响。
# 与检索服务分开配置，两者可独立部署与回滚。
#
# 注意：Go 业务服务的写连接目前只支持 SQLite。切换 MySQL 部署时不要配置该项，
# 让写路径留在 Python（Python 侧支持 SQLite 与 MySQL 两套方言）。
# GO_BUSINESS_URL=http://127.0.0.1:8082
