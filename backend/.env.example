# DeepSeek API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Embedding 模型（向量化）
EMBEDDING_MODEL=deepseek-embedding

# 检索模式：keyword（默认，纯 BM25）/ hybrid（关键词 + 向量 + RRF 融合）
# 注意：hybrid 需要可用的 embedding 供应商。DeepSeek 目前没有 embedding 接口，
# 需换成 OpenAI / 智谱 / 本地 BGE 等支持向量化的服务，并同步修改 EMBEDDING_MODEL
# 与 DEEPSEEK_BASE_URL。向量路失败时会自动退化为纯关键词检索。
# RETRIEVAL_MODE=keyword

# 数据库连接：不填则使用本地 SQLite（backend/app.db），零外部依赖。
# 切换 MySQL 时取消注释（端口与 docker-compose.yml 保持一致）：
# DATABASE_URL=mysql+pymysql://ainew:ainew@127.0.0.1:3307/ainew?charset=utf8mb4
#
# 连接池参数（仅服务端数据库生效，SQLite 忽略）：
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800

# 缓存（可选）：不填则不启用缓存，业务照常运行（令牌仍查库、限流降级放行）
# REDIS_URL=redis://127.0.0.1:6379/0
#
# 对话接口每分钟限流阈值，仅在缓存可用时生效
# RATE_LIMIT_CHAT_PER_MINUTE=10

# Go 检索服务地址（可选）：不填则检索与入库分块全部走本地 Python 实现。
# 配置后优先调用 Go，连接失败或超时会自动降级回本地，不影响业务。
# GO_RETRIEVAL_URL=http://127.0.0.1:8081

# Go 业务服务地址（可选）：不填则订单查询与待确认工单列表走本地 Python 实现。
# 配置后优先调用 Go（订单查询、待确认草稿列表），失败自动降级。
# 与检索服务分开配置，两者可独立部署与回滚。
# GO_BUSINESS_URL=http://127.0.0.1:8082
